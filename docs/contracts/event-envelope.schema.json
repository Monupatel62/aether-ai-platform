{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-ai.invalid/contracts/event-envelope.schema.json",
  "title": "Aether Event Envelope",
  "description": "Draft envelope for asynchronous events. Consumer idempotency and authorization checks remain mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "producer", "correlation_id", "payload"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+){1,5}$",
      "maxLength": 160
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version"],
      "properties": {
        "type": {"type": "string", "maxLength": 80},
        "id": {"type": "string", "maxLength": 128},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "payload": {
      "type": "object"
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wohotech.in/aether/contracts/error.schema.json",
  "title": "Aether API Error",
  "description": "Draft public error envelope. Never expose raw provider errors, stack traces, credentials, or sensitive upstream response bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "request_id"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "reason"],
            "properties": {
              "field": {"type": "string", "maxLength": 200},
              "reason": {"type": "string", "maxLength": 200}
            }
          }
        }
      }
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    }
  }
}